    {
      "dataset_type": "Collection",
      "short_title": "C-NMC 2019",
      "download_ids": ["41841"],
      "decision_status": "resolved",
      "resolution_type": "participant_pathdb_contract",
      "reviewed_at": "2026-08-20",
      "reviewer_note": "The published README defines non-overlapping subject membership and the UID subject token for training images. Training tokens resolve exactly to existing dataset-scoped PathDB participants. Preliminary-test BMP files resolve through an exact relative-path match to PathDB TIFF representations. Final-test files remain participant-unassigned because the published package uses numeric filenames and withholds the final ground truth.",
      "evidence_url": "https://www.cancerimagingarchive.net/wp-content/uploads/CNMC_readme.pdf",
      "supporting_evidence_url": "https://www.cancerimagingarchive.net/collection/c-nmc-2019/",
      "pathdb_non_participant_ids": ["NA_final"],
      "path_rules": [
        {
          "name": "readme_training_uid_subject",
          "pattern": "^C-NMC_training_data/fold_(?P<fold>[0-2])/(?P<class_name>all|hem)/UID_(?P<subject_prefix>H?)(?P<subject_number>[0-9]+)_[0-9]+_[0-9]+_(?P=class_name)[.]bmp$",
          "participant_id_template": "{subject_prefix}{subject_number}_training_fold{fold}_{class_name}"
        }
      ],
      "pathdb_file_rules": [
        {
          "name": "preliminary_exact_converted_pathdb_path",
          "pattern": "^C-NMC_test_prelim_phase_data/(?P<file_stem>[0-9]+)[.]bmp$",
          "pathdb_url_marker": "/converted/C-NMC_Leukemia/",
          "pathdb_relative_path_template": "C-NMC_test_prelim_phase_data/{file_stem}.tiff",
          "excluded_subject_ids": ["NA_final"]
        }
      ],
      "source_unavailable_rules": [
        {
          "name": "final_test_ground_truth_withheld",
          "pattern": "^C-NMC_test_final_phase_data/[0-9]+[.]bmp$",
          "reason": "final_test_participant_mapping_not_published"
        }
      ]
    },
