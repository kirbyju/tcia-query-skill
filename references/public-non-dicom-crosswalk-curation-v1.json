      "evidence_url": "https://www.cancerimagingarchive.net/collection/hungarian-colorectal-screening/",
      "identifier_source": "clinical_metadata.agent_clinical_all_subjects",
      "identifier_source_url": "https://www.cancerimagingarchive.net/wp-content/uploads/metadata_age_sex_icd10status.csv",
      "compact_path_rules": [
