    {
      "dataset_type": "Collection",
      "short_title": "DLBCL-Morphology",
      "download_ids": ["42421"],
      "decision_status": "resolved",
      "resolution_type": "participant_path_contract",
      "reviewed_at": "2026-08-20",
      "reviewer_note": "The WordPress dataset organization identifies WSI filenames, patch directories, and cell-array directories by patient_id. Observed WSI filenames retain that patient ID before a slide-number suffix; extracted identifiers must exactly match the official clinical participant list. Cell arrays are projected as compact participant groups. TMA slide IDs are not patient IDs and are excluded from these rules.",
      "evidence_url": "https://www.cancerimagingarchive.net/collection/dlbcl-morphology/",
      "identifier_source": "clinical_metadata.agent_clinical_all_subjects",
      "identifier_source_url": "https://www.cancerimagingarchive.net/wp-content/uploads/clinical_data_cleaned.csv",
      "path_rules": [
        {
          "name": "wordpress_wsi_filename_patient_id",
          "pattern": "^DLBCL-Morph/WSI/(?P<participant_id>[0-9]+)(?:_[0-9]+)?[.]svs$"
        },
        {
          "name": "wordpress_patch_patient_directory",
          "pattern": "^DLBCL-Morph/Patches/[^/]+/(?P<participant_id>[0-9]+)/[^/]+[.]png$"
        }
      ],
      "compact_path_rules": [
        {
          "name": "wordpress_cell_array_patient_directory",
          "pattern": "^DLBCL-Morph/Cells/(?P<participant_id>[0-9]+)/[^/]+/[^/]+[.]npy$",
          "source_file_format": "NPY",
          "asset_group": "cell_shape_arrays",
          "asset_label": "cell-shape arrays",
          "media_kind": "spectral_or_array",
          "spatial_dimensionality": "unknown",
          "temporal_dimensionality": "static",
          "imaging_domain": "pathology",
          "modality": "",
          "object_role": "cell_shape_array",
          "representation_provenance_class": "derived_asset"
        }
      ]
    },
    {
      "dataset_type": "Collection",
      "short_title": "HANCOCK",
      "download_ids": ["52636"],
      "decision_status": "resolved",
      "resolution_type": "participant_pathdb_contract",
      "reviewed_at": "2026-08-20",
      "reviewer_note": "HANCOCK contains three pathology grains. Cropped TMA-core PNG filenames carry the patientNNN identifier directly. Patient-specific lymph-node and primary-tumor WSI filenames carry the zero-padded numeric patient identifier after the HE token, including eight additional _a slides. Whole TMA block SVS files resolve by exact slide name to PathDB, whose participant junction supplies either the block's multi-patient membership or the single patient in block23. These metadata relationships do not assert that Aspera and PathDB representations are byte-identical.",
      "evidence_url": "https://www.cancerimagingarchive.net/collection/hancock/",
      "path_rules": [
        {
          "name": "tma_core_filename_patient_id",
          "pattern": "^Images/TMA_Cores/[^/]+/[^/]*_patient(?P<subject_number>[0-9]{3})[.]png$",
          "participant_id_template": "patient{subject_number}"
        },
        {
          "name": "patient_wsi_numeric_suffix",
          "pattern": "^Images/WSI_[^/]+/(?:LymphNode|PrimaryTumor)_HE_(?P<subject_number>[0-9]{3})(?:_a)?[.]svs$",
          "participant_id_template": "patient{subject_number}"
        }
      ],
      "pathdb_asset_rules": [
        {
          "name": "tma_block_exact_pathdb_slide_name",
          "pattern": "^Images/TMA_(?:InvasionFront|TumorCenter)/[^/]+/(?P<pathdb_asset_name>(?:InvasionFront|TumorCenter)_[^/]+_block[0-9]+)[.]svs$",
          "pathdb_asset_name_template": "{pathdb_asset_name}"
        }
      ]
    },
    {
